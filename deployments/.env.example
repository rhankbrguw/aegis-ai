# Application
APP_ENV=production
APP_PORT=8080
APP_URL=https://api-aegis.rhankbrguw.xyz
ALLOWED_ORIGINS=http://localhost:8080,https://api-aegis.rhankbrguw.xyz,https://rhankbrguw.xyz

# Redis (Docker Service Name or Host)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# AI Provider Credentials
OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
